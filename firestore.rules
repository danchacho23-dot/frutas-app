rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public read for products and store settings
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == 'gDK9Zay7iwSDh2dCdLdzXuR30PB2';
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == 'gDK9Zay7iwSDh2dCdLdzXuR30PB2';
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
