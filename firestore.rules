rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidOrder(data) {
      return data.keys().hasAll(['items', 'subtotal', 'deliveryFee', 'total', 'customerName', 'address', 'paymentMethod', 'status', 'createdAt'])
        && data.items is list && data.items.size() > 0 && data.items.size() <= 100
        && data.subtotal is number && data.deliveryFee is number && data.total is number
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200
        && data.address is string && data.address.size() > 0 && data.address.size() <= 500
        && data.paymentMethod is string && data.paymentMethod.size() <= 100
        && data.status == 'sent'
        && data.createdAt == request.time;
    }

    // Public read for products and store settings
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == 'gDK9Zay7iwSDh2dCdLdzXuR30PB2';
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == 'gDK9Zay7iwSDh2dCdLdzXuR30PB2';
    }

    // Customers (unauthenticated) can create orders so nothing is lost if
    // WhatsApp never gets sent, but only the admin can read/manage them.
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow read, update, delete: if request.auth != null && request.auth.uid == 'gDK9Zay7iwSDh2dCdLdzXuR30PB2';
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
